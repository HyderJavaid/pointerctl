# UNTESTED recipe (no Arch tooling on the author's machine). Build with: makepkg -si
pkgname=pointerctl
pkgver=0.1.0
pkgrel=1
pkgdesc='Unofficial settings tool for mice (DPI, polling rate, buttons, lighting); supports the Meetion GM21'
arch=('any')
url='https://github.com/naOomeow/pointerctl'
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/data/io.github.naoomeow.Pointerctl.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/data/io.github.naoomeow.Pointerctl.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 packaging/data/io.github.naoomeow.Pointerctl.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 udev/70-pointerctl.rules -t "$pkgdir/usr/lib/udev/rules.d"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
